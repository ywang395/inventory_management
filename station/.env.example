# The scanner station's settings. `uv run python scripts/station_env.py` writes the real
# station/.env (git-ignored) for you; this file only shows what's in it.

# The stack's ApiUrl output.
API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com/dev/
# This station's API key value (aws apigateway get-api-key --include-value). Secret.
API_KEY=replace-me
# Optional: where the offline queue is kept (default station/station.db).
# STATION_DB=station/station.db
